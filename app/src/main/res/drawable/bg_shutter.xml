<?xml version="1.0" encoding="utf-8"?>
<!--
  快门按钮底：外圈白细环 + 内缩的白色实心圆（专业相机风的快门造型）
  用 layer-list 一个文件搞定，免得在 Button 里再嵌 View（Button 不能有子 View）
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外环：整块圆形，只画描边 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="3dp"
                android:color="@color/cam_text" />
        </shape>
    </item>
    <!-- 内芯：四边各内缩 12dp 的白色实心圆 -->
    <item
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp">
        <shape android:shape="oval">
            <solid android:color="@color/cam_text" />
        </shape>
    </item>
</layer-list>
